{
  "$schema": "https://glama.ai/mcp/schema.json",
  "name": "tokenenrich-mcp",
  "description": "Sub-140ms B2B Company Intelligence & Technographic Signal API in ~180 Tokens for AI Agents.",
  "homepage": "https://tokenenrich.com",
  "repository": "https://github.com/quitegoodproject/tokenenrich",
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@quitegoodproject/tokenenrich-mcp@1.1.0"
    ],
    "env": {
      "TOKENENRICH_API_KEY": "${TOKENENRICH_API_KEY}",
      "TOKENENRICH_EMAIL": "${TOKENENRICH_EMAIL}"
    }
  },
  "tags": [
    "b2b-enrichment",
    "firmographics",
    "mcp",
    "ai-agents",
    "claude-desktop",
    "cursor"
  ]
}